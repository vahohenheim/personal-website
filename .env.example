# Copy to .env.local for local work. Never commit a value: only names belong here.
# Every variable is server-only (no NEXT_PUBLIC_ prefix).

# --- Neon database (leads of the contact form) --------------------------------
# Pooled connection, used at runtime. Without it, local development keeps leads in
# memory; production answers "service unavailable".
DATABASE_URL=
# Direct connection, used by `npm run db:setup` (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=

# --- Admin area (/admin, HTTP Basic) -------------------------------------------
# Without both, /admin refuses everyone.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Audience figures (Vercel Web Analytics, copied to Neon every day) ----------
# Vercel access token (Account Settings > Tokens), read by lib/analytics/vercel.ts.
# Without it, the daily copy does nothing and the admin says so.
WEB_ANALYTICS_TOKEN=
# Project id (Project Settings > General). Optional on Vercel, which provides
# VERCEL_PROJECT_ID; needed locally.
WEB_ANALYTICS_PROJECT_ID=
# Team id (Team Settings > General), only if the project belongs to a team and the
# token is not scoped to it.
WEB_ANALYTICS_TEAM_ID=

# --- Scheduled jobs (vercel.json, "crons") --------------------------------------
# Secret Vercel sends as `Authorization: Bearer` to /api/cron/*. Without it, the
# cron routes refuse everyone. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# --- Lotus (leads forwarded to the private management app) ----------------------
# Webhook of lotus that receives the leads: https://<lotus domain>/api/webhooks/leads
# Without both variables nothing is sent, and the site works as before.
# Never point a local or preview build at the production lotus.
LOTUS_WEBHOOK_URL=
# Shared secret that signs each request: the same value as LEADS_WEBHOOK_SECRET in
# lotus. Generate with `openssl rand -hex 32`.
LOTUS_WEBHOOK_SECRET=

# --- Protected posts (lib/constants/posts.ts, visibility: "protected") ------------
# Password Valentin gives, by hand, to the people who may read a protected post.
# Without both variables, protected posts stay closed (404).
PROTECTED_POSTS_PASSWORD=
# Signs the access cookie (HMAC). A long random string: `openssl rand -hex 32`.
# Changing it closes every post opened so far.
PROTECTED_POSTS_SECRET=
